# Local XAMPP defaults. Set the development URL to the exact URL used in your browser.
APP_ENV=development
DEVELOPMENT_WEBSITE_BASE_URL=http://localhost/Attendance-Management-System-master
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendancemsystem
DB_USER=root
DB_PASSWORD=

# Generate a private development key. Production uses QR_ATTENDANCE_TOKEN_KEY instead.
DEVELOPMENT_QR_ATTENDANCE_TOKEN_KEY=BASE64_ENCODED_RANDOM_32_BYTE_SECRET

# Optional external holiday integration.
CALENDARIFIC_API_KEY=
